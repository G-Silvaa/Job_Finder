# Copie para server/.env e ajuste o que quiser. Tudo é opcional:
# linhas começando com # são os valores padrão (tire o # para mudar).

# Porta e endereço do servidor (127.0.0.1 = só no seu computador)
# PORT=3001
# HOST=127.0.0.1

# Onde fica o banco SQLite
# DB_PATH=data/vagas.db

# De quantas em quantas horas verificar as fontes (0 = só manualmente). Cada fonte tem um intervalo
# mínimo próprio (30 min a 20 h), então mesmo de hora em hora nenhum site é consultado demais.
# COLLECT_INTERVAL_HOURS=1
# Buscar vagas ao iniciar o servidor (quando a última busca estiver velha)
# COLLECT_ON_START=true
# Ignorar vagas publicadas há mais de N dias. Sem definir: 60 dias nos quadros de vagas e até
# 1 ano nos sites de carreira das empresas (que só listam vagas abertas).
# MAX_JOB_AGE_DAYS=60
# Fora do Brasil, mostrar só vagas remotas (padrão: true)
# REMOTE_ONLY_OUTSIDE_BR=true
# Quantas fontes consultar ao mesmo tempo
# SOURCE_CONCURRENCY=4

# Desligar fontes (ids separados por vírgula). Ex.: DISABLED_SOURCES=teamlyzer,geekhunter
# DISABLED_SOURCES=
# Ou ligar só algumas. Ex.: ENABLED_SOURCES=gupy,github,himalayas
# ENABLED_SOURCES=

# --- Chaves gratuitas que liberam mais vagas ---

# GitHub: aumenta o limite da API (60 -> 5000 req/hora). Crie em github.com/settings/tokens (sem nenhuma permissão).
GITHUB_TOKEN=

# ITJobs.pt: API oficial com TODAS as vagas de TI de Portugal. Peça em https://www.itjobs.pt/api (só o e-mail).
ITJOBS_API_KEY=

# Adzuna (Brasil e EUA): https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble (Brasil, Portugal e EUA): https://jooble.org/api/about
JOOBLE_API_KEY=
